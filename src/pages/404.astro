---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Route Not Found | System Diagnostic Error"
  description="The requested memory address or route does not exist in the active application cluster."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center space-y-8">
    
    <!-- Big 404 Header -->
    <div class="relative inline-block select-none">
      <div class="text-7xl sm:text-9xl font-black font-mono tracking-tighter text-neutral-900">
        404
      </div>
    </div>

    <!-- Diagnostic Error Box -->
    <div class="bg-white p-6 sm:p-8 rounded-2xl border border-neutral-200 text-left font-mono text-xs sm:text-sm space-y-3 shadow-sm">
      <div class="flex items-center justify-between pb-3 border-b border-neutral-200 text-neutral-600">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="text-neutral-900 font-bold ml-2">ROUTE_NOT_FOUND: 404</span>
        </div>
        <span class="text-[11px] text-neutral-400">ERR_PAGE_FAULT</span>
      </div>

      <div class="space-y-1.5 text-neutral-700">
        <p class="text-neutral-900 font-medium">&gt; The requested URI was not found in the static routing table.</p>
        <p class="text-neutral-500">&gt; Target memory address does not resolve to an active page template.</p>
        <p class="text-neutral-800 font-medium">&gt; Recommended action: Return to home base or invoke Search (⌘K).</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
      <a
        href="/"
        class="px-8 py-3.5 rounded-xl font-mono text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-white shadow-xs transition-all"
      >
        <span>Return to Home Base ➔</span>
      </a>
      <a
        href="/projects"
        class="px-6 py-3.5 rounded-xl font-mono text-xs font-semibold bg-white border border-neutral-300 hover:bg-neutral-50 text-neutral-800 transition-all shadow-2xs"
      >
        Explore Projects
      </a>
      <a
        href="/contact"
        class="px-6 py-3.5 rounded-xl font-mono text-xs font-semibold text-neutral-700 hover:text-neutral-900 transition-colors"
      >
        Report Bug &gt;
      </a>
    </div>

  </div>
</BaseLayout>
