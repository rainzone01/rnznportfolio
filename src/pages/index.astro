---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3D from '../components/Hero3D';
import TypewriterHero from '../components/TypewriterHero';
import TechMarquee from '../components/TechMarquee.astro';
import StatsCounter from '../components/StatsCounter.astro';
import ApiFlowDiagram from '../components/ApiFlowDiagram';
import DatabaseDiagram from '../components/DatabaseDiagram';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout 
  title={`${siteConfig.name} | Full Stack Web Developer`} 
  description={siteConfig.tagline}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Content -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <!-- Availability Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-neutral-200/90 text-xs font-mono text-neutral-700 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            <span>Status: <span class="text-emerald-700 font-semibold">{siteConfig.availability}</span></span>
            <span class="text-neutral-300">•</span>
            <span class="text-neutral-500">{siteConfig.location}</span>
          </div>

          <!-- Main Title -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-neutral-900 leading-[1.15]">
            Engineering Resilient <br class="hidden sm:inline" />
            <span class="text-neutral-900 underline decoration-neutral-300 decoration-4 underline-offset-8">Full-Stack Systems</span> <br />
            Built for Clean Performance.
          </h1>

          <!-- Typewriter Role Subtitle -->
          <div class="py-1">
            <TypewriterHero client:load />
          </div>

          <!-- Tagline & Bio Teaser -->
          <p class="text-base sm:text-lg text-neutral-600 max-w-xl mx-auto lg:mx-0 leading-relaxed">
            {siteConfig.bio}
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
            <a 
              href="/projects" 
              class="px-7 py-3.5 rounded-xl font-mono text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-white shadow-xs transition-all"
            >
              Explore Flagship Projects ➔
            </a>
            <a 
              href="/resume" 
              class="px-6 py-3.5 rounded-xl font-mono text-xs font-semibold bg-white hover:bg-neutral-100 text-neutral-800 border border-neutral-300/90 shadow-2xs transition-all"
            >
              Inspect Resume / CV
            </a>
            <a 
              href="/contact" 
              class="px-6 py-3.5 rounded-xl font-mono text-xs font-semibold text-neutral-700 hover:text-neutral-900 transition-colors"
            >
              Get in Touch &gt;
            </a>
          </div>

          <!-- Quick Tech Badges -->
          <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs font-mono text-neutral-600">
            <span class="text-neutral-500">Core Stack:</span>
            <span class="px-2.5 py-1 rounded-md bg-white text-neutral-800 border border-neutral-200/90 shadow-2xs">PHP 8</span>
            <span class="px-2.5 py-1 rounded-md bg-white text-neutral-800 border border-neutral-200/90 shadow-2xs">Node / Express</span>
            <span class="px-2.5 py-1 rounded-md bg-white text-neutral-800 border border-neutral-200/90 shadow-2xs">React / Next.js</span>
            <span class="px-2.5 py-1 rounded-md bg-white text-neutral-800 border border-neutral-200/90 shadow-2xs">PostgreSQL</span>
            <span class="px-2.5 py-1 rounded-md bg-white text-neutral-800 border border-neutral-200/90 shadow-2xs">MySQL</span>
          </div>

        </div>

        <!-- Right 3D Visualizer -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <Hero3D client:visible />
        </div>

      </div>
    </div>
  </section>

  <!-- Infinite Tech Marquee -->
  <TechMarquee />

  <!-- Numerical Stats -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <StatsCounter />
  </section>

  <!-- Featured Projects Showcase -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 border-b border-neutral-200 pb-6">
      <div>
        <span class="text-xs font-mono text-neutral-500 font-semibold tracking-wider uppercase">
          Production Deployments
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 mt-2">
          Featured Architecture Case Studies
        </h2>
        <p class="text-sm text-neutral-600 mt-1">
          Complex engineering challenges solved with modern PHP, Next.js, and relational database indexing.
        </p>
      </div>

      <a 
        href="/projects" 
        class="text-xs font-mono text-neutral-900 hover:text-neutral-600 font-semibold flex items-center gap-1.5 transition-colors shrink-0"
      >
        <span>View Full Catalog ({allProjects.length})</span>
        <span>➔</span>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <div class="bg-white rounded-2xl p-6 flex flex-col justify-between border border-neutral-200 shadow-xs hover:border-neutral-400 hover:shadow-md transition-all group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-mono text-neutral-500 font-semibold uppercase">
                {project.data.category}
              </span>
              <span class="px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-700 text-[10px] font-mono border border-neutral-200 font-medium">
                Flagship
              </span>
            </div>

            <h3 class="text-xl font-bold text-neutral-900 group-hover:text-neutral-700 transition-colors mb-2">
              <a href={`/projects/${project.id}`}>{project.data.title}</a>
            </h3>

            <p class="text-sm text-neutral-600 leading-relaxed mb-6">
              {project.data.description}
            </p>

            {project.data.stats && (
              <div class="grid grid-cols-2 gap-2 mb-6 p-2.5 rounded-xl bg-neutral-50 border border-neutral-200 text-xs font-mono">
                {Object.entries(project.data.stats).slice(0, 2).map(([k, v]) => (
                  <div>
                    <div class="text-neutral-500 text-[10px] truncate">{k}</div>
                    <div class="text-neutral-900 font-semibold truncate">{v}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-6">
              {project.data.tags.map((t) => (
                <span class="px-2 py-0.5 rounded bg-neutral-100 border border-neutral-200 text-[10px] font-mono text-neutral-700">
                  {t}
                </span>
              ))}
            </div>

            <a 
              href={`/projects/${project.id}`}
              class="w-full py-2.5 rounded-xl font-mono text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-white flex items-center justify-center gap-1.5 transition-all shadow-xs"
            >
              <span>Explore Architectural Breakdown</span>
              <span>➔</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Interactive API Request/Response Flow -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ApiFlowDiagram client:visible />
  </section>

  <!-- Relational ER Model Section -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <DatabaseDiagram client:visible />
  </section>

  <!-- Testimonials Section -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <TestimonialsSection />
  </section>

  <!-- Contact CTA Banner -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-neutral-200 shadow-sm text-center space-y-6">
      <span class="text-xs font-mono text-neutral-600 font-semibold tracking-wider uppercase px-2.5 py-1 bg-neutral-100 rounded-md inline-block">
        Ready to Build or Scale?
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-900 max-w-2xl mx-auto leading-tight">
        Let's Architect Your Next Mission-Critical Platform.
      </h2>
      <p class="text-sm sm:text-base text-neutral-600 max-w-xl mx-auto leading-relaxed">
        Whether you require high-concurrency API optimization, database query tuning, or a ground-up full-stack web application, let's talk.
      </p>
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/contact" 
          class="px-8 py-4 rounded-xl font-mono text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-white shadow-xs transition-all"
        >
          Initiate Inquiry ➔
        </a>
        <a 
          href={`mailto:${siteConfig.email}`} 
          class="px-6 py-4 rounded-xl font-mono text-xs font-semibold bg-white border border-neutral-300 text-neutral-800 hover:bg-neutral-50 transition-all shadow-2xs"
        >
          {siteConfig.email}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
