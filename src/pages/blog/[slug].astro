---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextPost: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<BaseLayout
  title={`${data.title} | ${siteConfig.name}`}
  description={data.description}
  article={true}
  pubDate={data.pubDate}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">

    <!-- Top Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs font-mono text-neutral-500 pb-4 border-b border-neutral-200">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:underline">Blog</a>
      <span>/</span>
      <span class="text-neutral-900 font-medium truncate max-w-[200px] sm:max-w-xs">{data.title}</span>
    </div>

    <!-- Article Header -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-neutral-600">
        <span class="text-neutral-900 font-semibold">
          {data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
        <span class="text-neutral-300">•</span>
        <span class="text-neutral-600">{data.readingTime}</span>
        <span class="text-neutral-300">•</span>
        <span class="text-neutral-700">By {data.author}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-neutral-900 tracking-tight leading-tight">
        {data.title}
      </h1>

      <p class="text-base sm:text-lg text-neutral-600 font-normal leading-relaxed">
        {data.description}
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        {data.tags.map((tag) => (
          <span class="px-2.5 py-0.5 rounded-md bg-neutral-100 border border-neutral-200 text-xs font-mono text-neutral-700">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Article Content with Markdown Prose Styling -->
    <div class="prose max-w-none pt-6 border-t border-neutral-200 prose-headings:text-neutral-900 prose-p:text-neutral-700 prose-p:leading-relaxed prose-a:text-neutral-900 prose-a:font-semibold prose-pre:bg-neutral-900 prose-pre:text-white prose-pre:border prose-pre:border-neutral-800 prose-code:font-mono">
      <Content />
    </div>

    <!-- Author Bio Signature -->
    <div class="p-6 rounded-2xl bg-white border border-neutral-200 shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div class="w-16 h-16 rounded-2xl bg-neutral-100 border border-neutral-300 flex items-center justify-center text-neutral-900 text-xl font-mono font-bold shrink-0 shadow-xs">
        &lt;/&gt;
      </div>
      <div class="space-y-2 text-center sm:text-left">
        <h4 class="text-base font-bold text-neutral-900">{siteConfig.name}</h4>
        <p class="text-xs text-neutral-600 leading-relaxed max-w-xl">
          {siteConfig.bio}
        </p>
        <div class="pt-2 flex flex-wrap gap-3 justify-center sm:justify-start text-xs font-mono">
          <a href="/contact" class="text-neutral-900 font-semibold hover:underline">Discuss This Article ➔</a>
          <a href="/projects" class="text-neutral-700 hover:underline">Explore Architecture Projects ➔</a>
        </div>
      </div>
    </div>

    <!-- Next / Previous Post Navigation -->
    <div class="pt-8 border-t border-neutral-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`/blog/${prevPost.id}`}
          class="p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-400 transition-all shadow-xs group flex flex-col justify-between"
        >
          <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900">
            ← Older Article
          </span>
          <span class="text-sm font-bold text-neutral-800 group-hover:text-neutral-900 mt-1">
            {prevPost.data.title}
          </span>
        </a>
      ) : <div></div>}

      {nextPost ? (
        <a
          href={`/blog/${nextPost.id}`}
          class="p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-400 transition-all shadow-xs group flex flex-col justify-between text-right"
        >
          <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900">
            Newer Article →
          </span>
          <span class="text-sm font-bold text-neutral-800 group-hover:text-neutral-900 mt-1">
            {nextPost.data.title}
          </span>
        </a>
      ) : <div></div>}
    </div>

  </article>
</BaseLayout>
