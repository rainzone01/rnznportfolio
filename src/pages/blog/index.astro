---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter((p) => p.id !== featuredPost.id);
---

<BaseLayout
  title="Technical Engineering Blog | Architecture, PHP, Node & SQL"
  description="Technical deep dives on building high-throughput APIs, PostgreSQL query optimization, and modernizing legacy PHP architectures."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 border-b border-neutral-200 pb-8">
      <div class="space-y-3 max-w-2xl">
        <div class="flex items-center gap-2 text-xs font-mono text-neutral-500">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <span class="text-neutral-800 font-medium">Engineering Blog</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-neutral-900 tracking-tight">
          Articles &amp; Field Notes
        </h1>
        <p class="text-base text-neutral-600 leading-relaxed">
          Pragmatic engineering insights on databases, connection pooling, full-stack performance, and system migrations.
        </p>
      </div>

      <a
        href="/rss.xml"
        class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-neutral-300 text-xs font-mono text-neutral-800 hover:bg-neutral-50 transition-all shrink-0 shadow-2xs"
        title="Subscribe to RSS Feed"
      >
        <span>📡 RSS Feed</span>
      </a>
    </div>

    <!-- Featured Post Spotlight -->
    {featuredPost && (
      <div class="bg-white p-8 sm:p-10 rounded-2xl border border-neutral-200 shadow-sm relative overflow-hidden group hover:border-neutral-400 hover:shadow-md transition-all">
        <div class="relative z-10 space-y-4 max-w-3xl">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-800 border border-neutral-300 text-[11px] font-mono font-medium">
              Featured Deep Dive
            </span>
            <span class="text-xs font-mono text-neutral-500">
              {featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <span class="text-neutral-300">•</span>
            <span class="text-xs font-mono text-neutral-600">{featuredPost.data.readingTime}</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-neutral-900 group-hover:text-neutral-700 transition-colors">
            <a href={`/blog/${featuredPost.id}`}>
              {featuredPost.data.title}
            </a>
          </h2>

          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
            {featuredPost.data.description}
          </p>

          <div class="pt-2 flex flex-wrap gap-2">
            {featuredPost.data.tags.map((tag) => (
              <span class="px-2.5 py-0.5 rounded-md bg-neutral-100 border border-neutral-200 text-xs font-mono text-neutral-700">
                #{tag}
              </span>
            ))}
          </div>

          <div class="pt-4">
            <a
              href={`/blog/${featuredPost.id}`}
              class="inline-flex items-center gap-2 text-xs font-mono font-bold text-neutral-900 group-hover:text-neutral-600"
            >
              <span>Read Full Deep Dive</span>
              <span>➔</span>
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Remaining Articles Grid -->
    <div class="space-y-6">
      <h3 class="text-xs font-mono uppercase tracking-widest text-neutral-500 font-semibold">
        All Publications ({sortedPosts.length})
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {regularPosts.map((post) => (
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-neutral-200 shadow-xs hover:border-neutral-400 hover:shadow-md transition-all flex flex-col justify-between group">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-neutral-500">
                <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                <span class="text-neutral-600">{post.data.readingTime}</span>
              </div>

              <h4 class="text-xl font-bold text-neutral-900 group-hover:text-neutral-700 transition-colors">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h4>

              <p class="text-sm text-neutral-600 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="pt-6">
              <div class="flex flex-wrap gap-1.5 mb-4">
                {post.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-neutral-100 border border-neutral-200 text-[10px] font-mono text-neutral-600">
                    #{tag}
                  </span>
                ))}
              </div>

              <a
                href={`/blog/${post.id}`}
                class="text-xs font-mono font-bold text-neutral-900 group-hover:text-neutral-600 flex items-center gap-1.5 transition-colors"
              >
                <span>Read Article</span>
                <span>➔</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
