---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const rawExperience = await getCollection('experience');
const sortedExperience = rawExperience.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Experience & Career Timeline | Lorenzon Emmanuel S. Ahorro"
  description="Career journey spanning roles as Computer Programmer at Municipality of Bobon, UEP ICT Office, and BSIT education."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Header -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-500">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <span class="text-neutral-800 font-medium">Career Timeline</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-neutral-900 tracking-tight">
        Experience &amp; Career Journey
      </h1>
      <p class="text-base sm:text-lg text-neutral-600 leading-relaxed max-w-2xl">
        A real-world history of software development, public sector digitization, institutional systems, and IT support across the Municipality of Bobon and the University of Eastern Philippines.
      </p>
    </div>

    <!-- Vertical Timeline -->
    <div class="relative pl-6 sm:pl-10 space-y-12 before:absolute before:left-2 sm:before:left-3 before:top-3 before:bottom-3 before:w-[2px] before:bg-neutral-300">
      
      {sortedExperience.map((item) => (
        <div class="relative group">
          <!-- Timeline Node Marker -->
          <div class="absolute -left-6 sm:-left-10 top-1.5 w-4 h-4 sm:w-6 sm:h-6 rounded-full bg-white border-2 border-neutral-800 flex items-center justify-center -translate-x-1/2 group-hover:scale-110 group-hover:border-neutral-900 transition-all shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-900"></span>
          </div>

          <!-- Content Card -->
          <div class="bg-white p-6 sm:p-8 rounded-2xl border border-neutral-200 shadow-xs hover:border-neutral-400 hover:shadow-md transition-all group">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-neutral-100 border border-neutral-200 text-neutral-700 uppercase font-semibold">
                  {item.data.type}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 mt-2 group-hover:text-neutral-700 transition-colors">
                  {item.data.role}
                </h3>
                <div class="text-sm font-semibold text-neutral-700 mt-0.5">
                  {item.data.company} • <span class="text-neutral-500 font-normal">{item.data.location}</span>
                </div>
              </div>

              <div class="text-xs font-mono px-3 py-1.5 rounded-xl bg-neutral-100 border border-neutral-200 text-neutral-700 shrink-0 self-start sm:self-auto font-medium">
                {item.data.period}
              </div>
            </div>

            <!-- Highlights Bullet List -->
            <ul class="space-y-2.5 my-5 text-sm text-neutral-700 leading-relaxed">
              {item.data.highlights.map((highlight) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-neutral-900 font-bold shrink-0 mt-0.5">▹</span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <!-- Technologies Used -->
            <div class="pt-4 border-t border-neutral-100 flex flex-wrap gap-1.5">
              {item.data.technologies.map((tech) => (
                <span class="px-2.5 py-0.5 rounded-md bg-neutral-100 border border-neutral-200 text-[11px] font-mono text-neutral-700">
                  {tech}
                </span>
              ))}
            </div>

          </div>
        </div>
      ))}

    </div>

    <!-- Bottom CV Link -->
    <div class="pt-8 text-center">
      <a 
        href="/resume" 
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-mono text-xs font-semibold bg-neutral-900 hover:bg-neutral-800 text-white transition-all shadow-xs"
      >
        <span>View Full Printable Resume &amp; PDF Download</span>
        <span>➔</span>
      </a>
    </div>

  </div>
</BaseLayout>
