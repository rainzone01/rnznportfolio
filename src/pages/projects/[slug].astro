---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prevProject: index > 0 ? sorted[index - 1] : sorted[sorted.length - 1],
      nextProject: index < sorted.length - 1 ? sorted[index + 1] : sorted[0],
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<BaseLayout
  title={`${data.title} | Technical Case Study`}
  description={data.description}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">

    <!-- Top Navigation & Breadcrumbs -->
    <div class="flex items-center justify-between gap-4 pb-6 border-b border-neutral-200">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-500">
        <a href="/" class="hover:underline">Home</a>
        <span>/</span>
        <a href="/projects" class="hover:underline">Projects</a>
        <span>/</span>
        <span class="text-neutral-900 font-medium truncate max-w-[200px] sm:max-w-xs">{data.title}</span>
      </div>

      <div class="flex items-center gap-2">
        {data.githubUrl ? (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 text-xs font-mono font-medium text-white shadow-xs flex items-center gap-1.5 transition-all"
            title="View Public GitHub Repository"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub Repository</span>
            <span>↗</span>
          </a>
        ) : (
          <span
            class="px-3 py-1.5 rounded-lg bg-neutral-100 border border-neutral-300 text-xs font-mono text-neutral-600 flex items-center gap-1.5"
            title="Internal / Private Organization Repository"
          >
            <span>Private Repository</span>
          </span>
        )}
        {data.liveUrl && data.liveUrl !== '#' && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 rounded-lg bg-white border border-neutral-300 hover:bg-neutral-50 text-xs font-mono font-semibold text-neutral-900 shadow-2xs transition-all flex items-center gap-1.5"
          >
            <span>Live Deployment</span>
            <span>↗</span>
          </a>
        )}
      </div>
    </div>

    <!-- Title & Executive Summary -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-md bg-neutral-100 border border-neutral-200 text-neutral-700 text-xs font-mono font-semibold uppercase">
          {data.category}
        </span>
        {data.featured && (
          <span class="px-2.5 py-1 rounded-md bg-neutral-100 border border-neutral-300 text-neutral-800 text-xs font-mono font-medium">
            Flagship Enterprise
          </span>
        )}
      </div>

      <h1 class="text-4xl sm:text-5xl font-black text-neutral-900 tracking-tight">
        {data.title}
      </h1>

      <p class="text-lg sm:text-xl text-neutral-700 leading-relaxed font-normal">
        {data.longDescription}
      </p>

      <!-- Technology Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        {data.tags.map((tag) => (
          <span class="px-3 py-1 rounded-lg bg-white border border-neutral-200 text-xs font-mono text-neutral-800 shadow-2xs">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Highlight Metrics -->
    {data.stats && (
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {Object.entries(data.stats).map(([label, value]) => (
          <div class="p-5 rounded-2xl bg-white border border-neutral-200 shadow-xs">
            <div class="text-xs font-mono text-neutral-500 uppercase">{label}</div>
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-neutral-900 mt-1">{value}</div>
          </div>
        ))}
      </div>
    )}

    <!-- Screenshot & System Interface Carousel HUD -->
    <div class="rounded-2xl bg-white border border-neutral-200 overflow-hidden shadow-sm">
      <div class="px-4 py-3 bg-neutral-100/80 border-b border-neutral-200 flex items-center justify-between text-xs font-mono text-neutral-600">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-300"></span>
          <span class="text-neutral-800 ml-2">https://app.{project.id}.internal/console</span>
        </div>
        <span class="text-emerald-700 font-semibold">● 200 OK</span>
      </div>

      <!-- Conceptual Screen Preview Frame -->
      <div class="p-8 sm:p-12 bg-neutral-50 flex flex-col items-center justify-center min-h-[300px] text-center relative overflow-hidden">
        <div class="relative z-10 space-y-3 max-w-lg">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-white border border-neutral-300 flex items-center justify-center text-neutral-900 text-2xl font-mono font-bold shadow-xs">
            &lt;/&gt;
          </div>
          <h3 class="text-xl font-bold text-neutral-900">{data.title} Architecture Visualizer</h3>
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            {data.architecture || "Optimized data pipeline with strict relational schema consistency and low-latency frontend caching."}
          </p>
        </div>
      </div>
    </div>

    <!-- Problem vs Solution Comparison -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl bg-white border border-rose-200 shadow-xs space-y-3">
        <div class="flex items-center gap-2 text-rose-700 font-mono text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-rose-600"></span>
          <span>The Architectural Bottleneck</span>
        </div>
        <h3 class="text-lg font-bold text-neutral-900">Legacy Friction &amp; Problem</h3>
        <p class="text-sm text-neutral-700 leading-relaxed">
          {data.problem}
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-emerald-200 shadow-xs space-y-3">
        <div class="flex items-center gap-2 text-emerald-700 font-mono text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <span>Engineered Resolution</span>
        </div>
        <h3 class="text-lg font-bold text-neutral-900">Technical Solution</h3>
        <p class="text-sm text-neutral-700 leading-relaxed">
          {data.solution}
        </p>
      </div>
    </div>

    <!-- Key Engineered Features -->
    <div class="bg-white p-8 rounded-2xl border border-neutral-200 shadow-sm space-y-6">
      <h3 class="text-xl font-bold text-neutral-900 flex items-center gap-2">
        <span>Core Technical Capabilities</span>
        <span class="w-8 h-[2px] bg-neutral-900"></span>
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {data.features.map((feat) => (
          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-neutral-50 border border-neutral-200">
            <span class="text-emerald-700 font-bold text-sm shrink-0">✔</span>
            <span class="text-xs sm:text-sm text-neutral-700 leading-relaxed">{feat}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Markdown Rendered Deep Dive -->
    <div class="prose max-w-none prose-pre:bg-neutral-900 prose-pre:text-white prose-pre:border prose-pre:border-neutral-800 prose-headings:text-neutral-900 prose-p:text-neutral-700 prose-a:text-neutral-900 prose-a:font-semibold">
      <Content />
    </div>

    <!-- Next / Previous Project Navigation -->
    <div class="pt-12 border-t border-neutral-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href={`/projects/${prevProject.id}`}
        class="p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-400 transition-all shadow-xs group flex flex-col justify-between"
      >
        <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900 transition-colors">
          ← Previous Case Study
        </span>
        <span class="text-base font-bold text-neutral-800 group-hover:text-neutral-900 transition-colors mt-1">
          {prevProject.data.title}
        </span>
      </a>

      <a
        href={`/projects/${nextProject.id}`}
        class="p-5 rounded-2xl bg-white border border-neutral-200 hover:border-neutral-400 transition-all shadow-xs group flex flex-col justify-between text-right"
      >
        <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900 transition-colors">
          Next Case Study →
        </span>
        <span class="text-base font-bold text-neutral-800 group-hover:text-neutral-900 transition-colors mt-1">
          {nextProject.data.title}
        </span>
      </a>
    </div>

  </article>
</BaseLayout>
