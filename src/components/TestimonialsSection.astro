---
import { testimonialsData } from '../data/testimonials';
---

<div class="space-y-8">
  <div class="text-center max-w-2xl mx-auto">
    <span class="text-xs font-mono text-neutral-600 font-semibold tracking-wider uppercase px-2.5 py-1 bg-neutral-200/60 rounded-md inline-block">
      Client Feedback &amp; Trust
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mt-3">
      What Clients &amp; Leaders Say
    </h2>
    <p class="text-sm text-neutral-600 mt-2">
      Direct feedback from university officers, local government leaders, and engineering colleagues.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {testimonialsData.map((item) => (
      <div class="bg-white p-6 rounded-2xl flex flex-col justify-between border border-neutral-200 shadow-xs hover:border-neutral-400 hover:shadow-md transition-all">
        <div>
          <!-- Quote icon -->
          <div class="text-neutral-400 text-3xl font-serif leading-none mb-3">“</div>
          <p class="text-sm text-neutral-700 leading-relaxed italic mb-6">
            {item.content}
          </p>
        </div>

        <div class="pt-4 border-t border-neutral-100 flex items-center gap-3">
          <img 
            src={item.avatarUrl} 
            alt={item.author} 
            class="w-10 h-10 rounded-full object-cover border border-neutral-300"
            loading="lazy"
          />
          <div>
            <div class="text-xs font-bold text-neutral-900">{item.author}</div>
            <div class="text-[11px] text-neutral-500 font-medium">{item.role} • {item.company}</div>
            <div class="text-[10px] font-mono text-neutral-600 mt-0.5">Reference: {item.projectRelation}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
