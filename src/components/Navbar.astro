---
import { siteConfig } from '../config/site';
import CommandPalette from './CommandPalette';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header 
  id="main-navbar" 
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/90 border-b border-neutral-200/80 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a 
        href="/" 
        class="flex items-center gap-2.5 group text-decoration-none focus:outline-none"
        aria-label="Home"
      >
        <div class="w-8 h-8 rounded-lg bg-neutral-900 text-white flex items-center justify-center font-mono font-bold text-xs group-hover:bg-neutral-800 transition-colors">
          <span>&lt;/&gt;</span>
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-bold tracking-tight text-neutral-900 group-hover:text-neutral-700 transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-[10px] font-mono text-emerald-600 flex items-center gap-1.5 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            {siteConfig.availability}
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-1 bg-neutral-100/90 p-1 rounded-full border border-neutral-200/80">
        {siteConfig.navLinks.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-xs font-medium rounded-full transition-all ${
                active 
                  ? 'text-neutral-900 bg-white shadow-xs font-semibold border border-neutral-200/60' 
                  : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-200/60'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Side Tools: Command Palette + Contact CTA + Mobile Menu Button -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Command Palette React Island -->
        <CommandPalette client:idle />

        <!-- Secondary CTA: Contact -->
        <div class="hidden md:flex items-center gap-2">
          <a
            href="/contact"
            class="px-4 py-2 text-xs font-mono font-medium rounded-lg bg-neutral-900 text-white hover:bg-neutral-800 transition-colors shadow-xs"
          >
            Let's Talk
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-lg text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 border border-neutral-200"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div 
    id="mobile-menu" 
    class="lg:hidden hidden border-b border-neutral-200 bg-white/98 backdrop-blur-xl px-4 pt-3 pb-6 animate-in slide-in-from-top-2 duration-150"
  >
    <div class="grid grid-cols-2 gap-2 mb-4">
      {siteConfig.navLinks.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-2 text-xs font-mono rounded-lg transition-all ${
              active 
                ? 'bg-neutral-100 text-neutral-900 font-bold border border-neutral-200' 
                : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <div class="pt-3 border-t border-neutral-200 flex items-center justify-between text-xs font-mono text-neutral-500">
      <span>{siteConfig.location}</span>
      <a 
        href="/contact" 
        class="px-3.5 py-1.5 rounded-lg bg-neutral-900 text-white font-medium hover:bg-neutral-800 transition-colors"
      >
        Hire Developer
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !menu || !menuIcon || !closeIcon) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close menu when clicking any mobile link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>
