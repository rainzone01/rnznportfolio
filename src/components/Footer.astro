---
import { siteConfig } from '../config/site';
---

<footer class="relative z-10 border-t border-neutral-200/80 bg-neutral-100/70 text-neutral-600 font-sans mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-neutral-200">
      
      <!-- Brand & Status -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-neutral-900 text-white flex items-center justify-center font-mono font-bold text-xs">
            &lt;/&gt;
          </div>
          <span class="text-base font-bold text-neutral-900">{siteConfig.name}</span>
        </div>
        <p class="text-sm text-neutral-600 max-w-md leading-relaxed">
          {siteConfig.tagline}
        </p>

        <!-- Live Developer Status & Local Clock -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-neutral-600 pt-2">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-neutral-200 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-neutral-900 font-medium">{siteConfig.availability}</span>
          </div>

          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-neutral-200 shadow-xs">
            <span>📍</span>
            <span>{siteConfig.location}</span>
          </div>

          <div id="footer-clock-badge" class="px-3 py-1.5 rounded-full bg-white border border-neutral-200 shadow-xs text-neutral-900 font-medium">
            <span id="live-clock">--:--:--</span> <span class="text-neutral-400 text-[10px]">UTC+8</span>
          </div>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-900 mb-4 font-semibold">
          Pages
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/projects" class="hover:text-neutral-950 transition-colors">Projects Catalog</a></li>
          <li><a href="/skills" class="hover:text-neutral-950 transition-colors">Skills &amp; Tech Stack</a></li>
          <li><a href="/experience" class="hover:text-neutral-950 transition-colors">Career Timeline</a></li>
          <li><a href="/services" class="hover:text-neutral-950 transition-colors">Services &amp; Offerings</a></li>
          <li><a href="/github" class="hover:text-neutral-950 transition-colors">GitHub Activity</a></li>
        </ul>
      </div>

      <!-- Contact & Socials -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-900 mb-4 font-semibold">
          Connect
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 transition-colors flex items-center gap-1">
              <span>GitHub</span>
              <span class="text-xs text-neutral-400">↗</span>
            </a>
          </li>
          <li>
            <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 transition-colors flex items-center gap-1">
              <span>LinkedIn</span>
              <span class="text-xs text-neutral-400">↗</span>
            </a>
          </li>
          {siteConfig.socials.facebook && (
            <li>
              <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 transition-colors flex items-center gap-1">
                <span>Facebook</span>
                <span class="text-xs text-neutral-400">↗</span>
              </a>
            </li>
          )}
          <li>
            <a href="/resume" class="hover:text-neutral-950 transition-colors">
              Online Resume / CV
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="text-neutral-900 font-medium hover:underline">
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Tech Stack Badge -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-neutral-500">
      <p>
        © {new Date().getFullYear()} {siteConfig.name}. Clean &amp; Modern Portfolio built with Astro &amp; React.
      </p>
      <div class="flex items-center gap-4">
        <a href="/sitemap-index.xml" class="hover:text-neutral-900 transition-colors">Sitemap</a>
        <span>•</span>
        <span class="text-emerald-700 font-medium">● ACTIVE</span>
      </div>
    </div>

  </div>
</footer>

<script>
  function updateLiveClock() {
    const clockEl = document.getElementById('live-clock');
    if (!clockEl) return;
    const now = new Date();
    clockEl.textContent = now.toLocaleTimeString('en-US', { hour12: false });
  }

  setInterval(updateLiveClock, 1000);
  updateLiveClock();
</script>
